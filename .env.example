# AUTOVYNEX — Environment Configuration Template
# Copy this file to .env and configure for your local environment

DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key-for-your-installation
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Database Configuration (MySQL 8.4)
# When MySQL 8.4 is running:
DB_ENGINE=django.db.backends.mysql
DB_NAME=autovynex_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# SQLite fallback option for development without MySQL running:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=autovynex_db.sqlite3

# Windows PowerShell MySQL 8.4 Setup Instructions:
# 1. Start MySQL 8.4 Server:
#    Start-Service -Name MySQL84   (or MySQL80, MySQL)
# 2. Login to MySQL client:
#    mysql -u root -p
# 3. Create database:
#    CREATE DATABASE autovynex_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# 4. Run Django migrations:
#    python manage.py migrate
# 5. Populate sample automotive data:
#    python manage.py seed_autovynex
