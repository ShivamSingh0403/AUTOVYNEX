# AUTOVYNEX Environment Configuration
# Copy this file to .env and configure for your environment

DEBUG=True
SECRET_KEY=autovynex-super-secret-demo-key-change-in-production-2026-secure
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (MySQL 8.4)
# If DB_ENGINE is left blank or set to sqlite, SQLite3 will be used as the development fallback
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=autovynex_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# For MySQL 8.4 setup:
# 1. Start MySQL 8.4 service
# 2. In MySQL prompt: CREATE DATABASE autovynex_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# 3. Change DB_ENGINE to: django.db.backends.mysql
# 4. Run: python manage.py migrate
